{"type":"api-request-blob","sessionId":"159a4645-4bae-4261-ac0b-464a7f4accd7","hash":"234fe25a899cbf7ad9d2bbe9a1952379336f0a132c73a58fff411b4fde019417","message":{"role":"user","content":[{"tool_use_id":"toolu_013hX9ee85jZd8LMWywUowSa","type":"tool_result","content":"    # ---------- S7: the kit (cards align into a grid) ----------\n    t0 = START[\"s7\"]\n    ctitle = COPY[\"product_title\"]\n    tiles = [\n        (\"VIDEO AD · 10 s\", 110, 304, '<img src=\"assets/s/ad-frame.jpg\" style=\"width:100%; height:100%; object-fit:cover\">', \"vid\"),\n        (\"IMAGE DECK · 7 slides\", 439, 440, '<img src=\"assets/s/deck_slide-2.jpg\" style=\"width:100%; height:100%; object-fit:cover\">', \"deck\"),\n        (\"STUDIO PHOTOS · 5\", 904, 440, '<img src=\"assets/s/studio_image-2.jpg\" style=\"width:100%; height:100%; object-fit:cover\">', \"stu\"),\n        (\"COPY · 3 platforms\", 1369, 440, f'<div style=\"padding:70px 34px 34px; color:var(--ink)\"><div class=\"mono\" style=\"font-size:18px; color:var(--turq-d)\">Shopify · page copy</div><div style=\"font-size:32px; font-we\n    ]\n    th = []\n    for n, (lab, x, w, inner, key) in enumerate(tiles):\n        th.append(f'<div id=\"s7t{n}\" class=\"abs\" style=\"left:{x}px; top:410px; width:{w}px; height:540px; border-radius:24px; overflow:hidden; background:#fff; box-shadow:0 0 0 1.5px rgba(8,47,51,.1), 0 40px 80px -44px r\n                  f'<div class=\"mono abs\" style=\"left:14px; top:14px; font-size:17px; color:#fff; background:var(--ocean); border-radius:20px; padding:9px 16px\">{lab}</div></div>')\n    html.append(scene_open(\"s7\", \"kit\", \"light\") + bug(\"s7\") +\n                f'<div id=\"s7k\" class=\"abs mono\" style=\"left:110px; top:150px; font-size:26px; color:var(--turq-d)\">05 · Your kit</div>'\n                f'<div id=\"s7t\" class=\"abs big\" style=\"left:110px; top:200px; width:1500px; font-size:96px\">{words(\"Everything in one kit.\")}</div>'\n                + \"\".join(th) + dots(\"s7\", 3) + \"</div>\")\n    js.append(\"  // s7\")\n    js.append(f'  tl.from(\"#s7k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f});')\n    reveal(\"s7t\", t0 + 0.12, 0.07)\n    for n in range(4):\n        tt = t0 + 0.7 + n * 0.34\n        js.append(f'  tl.from(\"#s7t{n}\", {{ opacity: 0, y: 90, duration: 0.55, ease: \"power3.out\" }}, {tt:.2f});')\n        ev[\"click\"].append(tt)\n\n    # ---------- S8: the video ad on a phone (Amii) ----------\n    t0 = START[\"s8\"]\n    html.append(scene_open(\"s8\", \"phone\", \"light\") + bug(\"s8\") +\n                '<div id=\"s8p\" class=\"abs\" style=\"left:330px; top:104px; width:490px; height:872px; border-radius:68px; background:#021f22; box-shadow:0 70px 130px -50px rgba(0,49,53,.6), 0 0 0 2px rgba(8,47,51,.2)\"></di\n                f'<div class=\"col\" style=\"left:960px; top:250px; width:860px; gap:28px\">'\n                f'<div id=\"s8k\" class=\"mono\" style=\"font-size:26px; color:var(--turq-d)\">On your phone</div>'\n                f'<div id=\"s8t\" class=\"big\" style=\"font-size:104px\">{words(\"A 10-second\")}<br>{words(\"vertical ad.\")}</div>'\n                f'<div id=\"s8s\" style=\"font-size:34px; line-height:1.35; color:var(--muted); width:760px\">Built from your own photos, with real camera moves and text. Image processing and FFmpeg, not generated footage.</\n    js.append(\"  // s8\")\n    js.append(f'  tl.from(\"#s8p\", {{ opacity: 0, y: 90, duration: 0.65, ease: \"power3.out\" }}, {t0 + 0.05:.2f});')\n    js.append(f'  tl.from(\"#s8k\", {{ opacity: 0, x: 30, duration: 0.35 }}, {t0 + 0.2:.2f}); ')\n    reveal(\"s8t\", t0 + 0.25, 0.08)\n    js.append(f'  tl.from(\"#s8s\", {{ opacity: 0, y: 20, duration: 0.5 }}, {t0 + 0.9:.2f});')\n    ev[\"click\"].append(t0 + 0.9)\n\n    # ---------- S9: copy for each platform (typed, mono) ----------\n    t0 = START[\"s9\"]\n    plats = [(\"Caption\", \"CAPTION\", wrap(CAPTION, 38)), (\"Shopify\", \"SHOPIFY · PAGE COPY\", wrap(SHOP, 38)), (\"Pinterest\", \"PINTEREST · PIN TITLE\", wrap(PIN, 38))]\n    panel = []\n    # ---------- S10: trust, \"Nothing made up\" ----------\n    t0 = START[\"s10\"]\n    tm = [\"Missing facts listed\", \"Regulated claims flagged\", \"You approve every post\"]\n    items = \"\".join(f'<div id=\"s10m{n}\" class=\"abs\" style=\"left:0; top:{n * 108}px; width:460px; font-size:34px; font-weight:500; line-height:1.15; color:var(--ink); display:flex; align-items:center; \n    html.append(scene_open(\"s10\", \"trust\", \"light\") + bug(\"s10\") +\n                f'<div id=\"s10k\" class=\"abs mono\" style=\"left:110px; top:180px; font-size:26px; color:var(--turq-d)\">07 · Trust</div>'\n                f'<div id=\"s10menu\" class=\"abs\" style=\"left:110px; top:290px; width:470px; height:360px\">{items}</div>'\n                '<div id=\"s10card\" class=\"abs\" style=\"left:620px; top:290px; width:740px; height:372px; border-radius:26px; overflow:hidden; background:#003135; box-shadow:0 50px 110px -44px rgba(0,49\n                '<img id=\"s10i\" src=\"assets/s/insights-crop.jpg\" style=\"position:absolute; left:0; top:0; width:740px; height:auto\"></div>'\n                '<div id=\"s10cap\" class=\"abs mono\" style=\"left:620px; top:690px; width:740px; font-size:20px; color:#566A6D; line-height:1.5\">From the real kit · facts the seller never gave are listed\n                f'<div id=\"s10h\" class=\"abs big\" style=\"left:1400px; top:300px; width:480px; font-size:112px; line-height:1.0\">{words(\"Nothing\")}<br>{words(\"made up.\")}</div>'\n                + dots(\"s10\", 4) + \"</div>\")\n    js.append(\"  // s10\")\n    js.append(f'  tl.from(\"#s10k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f}); tl.from(\"#s10card\", {{ opacity: 0, y: 70, duration: 0.6, ease: \"power3.out\" }}, {t0 + 0.1:.2f});')\n    reveal(\"s10h\", t0 + 0.3, 0.12)\n    js.append(f'  tl.from(\"#s10cap\", {{ opacity: 0, y: 16, duration: 0.45 }}, {t0 + 0.9:.2f});')\n    for n in range(3):\n        tt = t0 + 0.7 + n * 0.5\n        js.append(f'  tl.from(\"#s10m{n}\", {{ opacity: 0, x: -30, duration: 0.4 }}, {tt:.2f});')\n        ev[\"click\"].append(tt)\n\n    # ---------- S11: benefits (editorial pills) ----------\n    t0 = START[\"s11\"]\n    lines = [(\"Runs on your\", \"machine.\"), (\"Built on\", \"open models.\"), (\"No per-kit\", \"fees.\"), (\"Posts only\", \"when you tap.\")]\n    rows = \"\".join(f'<div id=\"s11r{n}\" class=\"abs big\" style=\"left:110px; top:{190 + n * 200}px; font-size:128px; white-space:nowrap\">{a} <span class=\"pill\" id=\"s11p{n}\" style=\"{\"\" if n % 2 == 0 else \n    html.append(scene_open(\"s11\", \"benefits\", \"light\") + bug(\"s11\") + f'<div id=\"s11k\" class=\"abs mono\" style=\"left:110px; top:136px; font-size:24px; color:var(--turq-d)\">08 · Why it matters</div>' + \n    js.append(\"  // s11\")\n    js.append(f'  tl.from(\"#s11k\", {{ opacity: 0, duration: 0.3 }}, {t0 + 0.05:.2f});')\n    for n in range(4):\n        tt = t0 + 0.25 + n * 0.62\n        js.append(f'  tl.from(\"#s11r{n}\", {{ opacity: 0, x: -80, duration: 0.5, ease: \"power3.out\" }}, {tt:.2f}); tl.from(\"#s11p{n}\", {{ clipPath: \"inset(0 100% 0 0)\", duration: 0.45, ease: \"power3.ou\n        ev[\"click\"].append(tt + 0.3)\n\n    # ---------- S12: results on dark (Scaledown big numbers) ----------\n    t0 = START[\"s12\"]\n    html.append(scene_open(\"s12\", \"stats\", \"dark\") +","is_error":false}]}}
