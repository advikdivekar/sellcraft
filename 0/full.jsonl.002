-weight:500; line-height:1.15; color:var(--ink); display:flex; align-items:center; gap:18px\"><span style=\"width:16px; height:16px; background:var(--turq-d); border-radius:4px; flex:none\"></span>{m}</div>' for n, m in enumerate(tm))\n    html.append(scene_open(\"s10\", \"trust\", \"light\") + bug(\"s10\") +\n                f'<div id=\"s10k\" class=\"abs mono\" style=\"left:110px; top:180px; font-size:26px; color:var(--turq-d)\">07 · Trust</div>'\n                f'<div id=\"s10menu\" class=\"abs\" style=\"left:110px; top:300px; width:470px; height:360px\">{items}</div>'\n                '<div id=\"s10card\" class=\"abs\" style=\"left:640px; top:170px; width:700px; height:740px; border-radius:30px; overflow:hidden; background:#003135; box-shadow:0 50px 110px -44px rgba(0,49,53,.6)\">'\n                '<img id=\"s10i\" src=\"assets/s/d-10-insights.jpg\" style=\"position:absolute; left:0; top:0; width:2200px; height:1400px; transform-origin:0 0\"></div>'\n                f'<div id=\"s10h\" class=\"abs big\" style=\"left:1400px; top:300px; width:460px; font-size:128px; line-height:.98\">{words(\"Nothing\")}<br>{words(\"made up.\")}</div>'\n                + dots(\"s10\", 4) + \"</div>\")\n    js.append(\"  // s10\")\n    js.append(f'  tl.from(\"#s10k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f}); tl.from(\"#s10card\", {{ opacity: 0, y: 70, duration: 0.6, ease: \"power3.out\" }}, {t0 + 0.1:.2f});')\n    sa, sb = 700 / 1050, 700 / 760\n    js.append(f'  gsap.set(\"#s10i\", {{ x: {-30 * sa:.2f}, y: {-760 * sa:.2f}, scale: {sa:.4f} }}); tl.to(\"#s10i\", {{ x: {-40 * sb:.2f}, y: {-870 * sb:.2f}, scale: {sb:.4f}, duration: {SC[9][3] - 0.2:.2f}, ease: \"power2.inOut\" }}, {t0 + 0.1:.2f});')\n    reveal(\"s10h\", t0 + 0.3, 0.12)\n    for n in range(3):\n        tt = t0 + 0.7 + n * 0.5\n        js.append(f'  tl.from(\"#s10m{n}\", {{ opacity: 0, x: -30, duration: 0.4 }}, {tt:.2f});')\n        ev[\"click\"].append(tt)\n\n    # ---------- S11: benefits (editorial pills) ----------\n    t0 = START[\"s11\"]\n    lines = [(\"Runs on your\", \"machine.\"), (\"Built on\", \"open models.\"), (\"No per-kit\", \"fees.\"), (\"Posts only\", \"when you tap.\")]\n    rows = \"\".join(f'<div id=\"s11r{n}\" class=\"abs big\" style=\"left:110px; top:{190 + n * 200}px; font-size:128px; white-space:nowrap\">{a} <span class=\"pill\" id=\"s11p{n}\" style=\"{\"\" if n % 2 == 0 else \"background:var(--terra)\"}\"><span id=\"s11pt{n}\" style=\"display:inline-block\">{b}</span></span></div>' for n, (a, b) in enumerate(lines))\n    html.append(scene_open(\"s11\", \"benefits\", \"light\") + bug(\"s11\") + f'<div id=\"s11k\" class=\"abs mono\" style=\"left:110px; top:136px; font-size:24px; color:var(--turq-d)\">08 · Why it matters</div>' + rows + \"</div>\")\n    js.append(\"  // s11\")\n    js.append(f'  tl.from(\"#s11k\", {{ opacity: 0, duration: 0.3 }}, {t0 + 0.05:.2f});')\n    for n in range(4):\n        tt = t0 + 0.25 + n * 0.62\n        js.append(f'  tl.from(\"#s11r{n}\", {{ opacity: 0, x: -80, duration: 0.5, ease: \"power3.out\" }}, {tt:.2f}); tl.from(\"#s11p{n}\", {{ clipPath: \"inset(0 100% 0 0)\", duration: 0.45, ease: \"power3.out\" }}, {tt + 0.25:.2f});')\n        ev[\"click\"].append(tt + 0.3)\n\n    # ---------- S12: results on dark (Scaledown big numbers) ----------\n    t0 = START[\"s12\"]\n    html.append(scene_open(\"s12\", \"stats\", \"dark\") +\n                f'<div id=\"s12k\" class=\"abs mono\" style=\"left:110px; top:130px; font-size:26px; color:var(--ice)\">09 · Results</div>'\n                f'<div id=\"s12a\" class=\"abs\" style=\"left:110px; top:250px; width:1150px\"><div class=\"num\" style=\"font-size:230px; line-height:1; color:#fff\">18<span style=\"font-size:.5em\">%</span> <span style=\"color:var(--turq)\">→</span> 88<span style=\"font-size:.5em\">%</span></div><div class=\"mono\" style=\"font-size:24px; color:var(--ice); margin-top:18px\">Clean kits · untuned model vs Mochi fine-tune</div></div>'\n                f'<div id=\"s12b\" class=\"abs\" style=\"left:1330px; top:250px; width:520px\"><div class=\"num\" style=\"font-size:230px; line-height:1; color:#fff\">{BUILD_S}<span style=\"font-size:.5em; color:var(--turq)\">s</span></div><div class=\"mono\" style=\"font-size:24px; color:var(--ice); margin-top:18px\">Whole kit · fast mode</div></div>'\n                f'<div id=\"s12c\" class=\"abs\" style=\"left:110px; top:760px; width:1500px; font-size:28px; line-height:1.4; color:rgba(175,221,229,.9)\">60 held-out tests · deterministic checker · an independent judge (n=30) shows a smaller gain · measured on a synthetic test set</div>'\n                f'<div id=\"s12bar\" class=\"abs\" style=\"left:110px; top:700px; width:0; height:6px; background:var(--terra); border-radius:3px\"></div></div>')\n    js.append(\"  // s12\")\n    js.append(f'  tl.from(\"#s12k\", {{ opacity: 0, duration: 0.3 }}, {t0 + 0.05:.2f}); tl.from(\"#s12a\", {{ opacity: 0, y: 60, duration: 0.55, ease: \"power3.out\" }}, {t0 + 0.2:.2f}); tl.from(\"#s12b\", {{ opacity: 0, y: 60, duration: 0.55, ease: \"power3.out\" }}, {t0 + 0.9:.2f});')\n    js.append(f'  tl.to(\"#s12bar\", {{ width: 300, duration: 0.6 }}, {t0 + 1.6:.2f}); tl.from(\"#s12c\", {{ opacity: 0, y: 20, duration: 0.5 }}, {t0 + 1.9:.2f});')\n    ev[\"blip\"].extend([(t0 + 0.7, 2), (t0 + 1.4, 3)])\n\n    # ---------- S13: end card ----------\n    t0 = START[\"s13\"]\n    html.append(scene_open(\"s13\", \"end\", \"dark\") +\n                '<div id=\"s13l\" class=\"abs\" style=\"left:0; width:1920px; top:290px; display:flex; justify-content:center; align-items:center; gap:34px\"><img src=\"assets/brand/mochi-tile.png\" style=\"width:150px; height:150px; border-radius:28%; box-shadow:0 30px 70px -26px rgba(0,0,0,.6)\"><b style=\"font-family:Manrope,sans-serif; font-weight:800; font-size:150px; letter-spacing:-.04em; text-transform:lowercase; color:#fff; line-height:1\">mochi</b></div>'\n                f'<div id=\"s13a\" class=\"abs big\" style=\"left:0; width:1920px; text-align:center; top:520px; font-size:84px; color:#fff\">{words(\"One photo. A whole marketing kit.\")}</div>'\n                '<div id=\"s13b\" class=\"abs\" style=\"left:0; width:1920px; text-align:center; top:660px; font-size:42px; color:var(--ice)\">Built with open models. Designed around your workflow.</div>'\n                '<div id=\"s13bar\" class=\"abs\" style=\"left:820px; top:745px; width:0; height:6px; background:var(--terra); border-radius:3px\"></div>'\n                '<div id=\"s13u\" class=\"abs mono\" style=\"left:0; width:1920px; text-align:center; top:790px; font-size:28px; color:#fff\">Open source · github.com/advikdivekar/sellcraft</div></div>')\n    js.append(\"  // s13\")\n    js.append(f'  tl.from(\"#s13l\", {{ opacity: 0, scale: 0.9, duration: 0.65, ease: \"power3.out\" }}, {t0 + 0.05:.2f});')\n    reveal(\"s13a\", t0 + 0.6, 0.09)\n    js.append(f'  tl.from(\"#s13b\", {{ opacity: 0, y: 20, duration: 0.5 }}, {t0 + 1.4:.2f}); tl.to(\"#s13bar\", {{ width: 280, duration: 0.5 }}, {t0 + 1.8:.2f}); tl.from(\"#s13u\", {{ opacity: 0, y: 16, duration: 0.5 }}, {t0 + 2.1:.2f});')\n    ev[\"bell\"].extend([START[\"s2\"] + 0.1, t0 + 0.1])\n    ev[\"resolve\"].append(t0 + 0.1)\n\n    # ---------- scene-boundary wipes + whooshes ----------\n    wipes = []\n    for sid, kind, st, du in SC[1:]:\n        wipes.append(f'<div id=\"wp{sid}\" class=\"wipe\"></div>')\n        js.append(f'  tl.fromTo(\"#wp{sid}\", {{ x: 0 }}, {{ x: 2180, duration: 0.42, ease: \"power2.inOut\" }}, {st - 0.21:.2f});')\n        ev[\"whoosh\"].append(st - 0.2)\n    video = (f'<video id=\"adv\" class=\"clip\" data-start=\"{START[\"s8\"] + 0.45}\" data-duration=\"4.5\" data-track-index=\"2\" muted playsinline src=\"assets/ad-clip.mp4\" '\n             'style=\"position:absolute; left:352px; top:126px; width:446px; height:828px; border-radius:48px; object-fit:cover; z-index:5\"></video>')\n    page = f'''<!doctype html>\n<html lang=\"en\" data-resolution=\"landscape\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=1920, height=1080\" />\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n<style>{CSS}</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-start=\"0\" data-duration=\"{TOTAL:.2f}\" data-width=\"1920\" data-height=\"1080\" data-fps=\"60\">\n{chr(10).join(html)}\n{video}\n{chr(10).join(wipes)}\n<script>\n(function () {{\n  const tl = gsap.timeline({{ paused: true }});\n  const reveal = function (id, t, gap) {{ document.querySelectorAll(\"#\" + id + \" .w\").forEach(function (w, i) {{ tl.from(w, {{ opacity: 0, y: 44, duration: 0.5, ease: \"power3.out\" }}, t + i * gap); }}); }};\n  const mk = function (id, markup) {{ const el = document.createElement(\"span\"); el.innerHTML = markup; el.style.cssText = \"position:absolute;left:0;top:0;visibility:hidden;white-space:nowrap\"; document.getElementById(id).appendChild(el); return el; }};\n{chr(10).join(js)}\n  window.__timelines = window.__timelines || {{}};\n  window.__timelines[\"main\"] = tl;\n  tl.seek(0);\n}})();\n</script>\n</div>\n</body>\n</html>'''\n    (ROOT / \"project\" / \"index.html\").write_text(page)\n    return ev\n\n\n# ---------------- procedural soundtrack ----------------\nSR = 48000\n\n\ndef add(buf, sig, t):\n    i = int(t * SR)\n    if i < 0 or i >= len(buf):\n        return\n    j = min(len(buf), i + len(sig))\n    buf[i:j] += sig[: j - i]\n\n\ndef bandnoise(n, f0, f1, rng):\n    out = np.zeros(n + 4096)\n    c = 2048\n    win = np.hanning(c)\n    noise = rng.standard_normal(n + c * 2)\n    for s in range(0, n, c // 2):\n        seg = noise[s: s + c]\n        if len(seg) < c:\n            break\n        sp = np.fft.rfft(seg * win)\n        f = np.fft.rfftfreq(c, 1 / SR)\n        ctr = f0 * (f1 / f0) ** (s / n)\n        sp *= np.exp(-0.5 * ((np.log2(f + 1) - np.log2(ctr)) / 0.9) ** 2)\n        out[s: s + c] += np.fft.irfft(sp) * win\n    out = out[:n]\n    return out / (np.max(np.abs(out)) + 1e-9)\n\n\ndef make_audio(ev):\n    rng = np.random.default_rng(11)\n    n = int((TOTAL + 2.5) * SR)\n    mus, fx = np.zeros(n), np.zeros(n)\n    bpm = 112\n    beat = 60 / bpm\n    chords = [(110.0, 164.81, 220.0, 261.63, 329.63, 493.88), (87.31, 130.81, 174.61, 220.0, 261.63, 329.63), (65.41, 130.81, 196.0, 246.94, 329.63, 392.0), (98.0, 146.83, 196.0, 246.94, 293.66, 392.0)]\n    clen = beat * 16\n    t, k = 0.0, 0\n    while t < TOTAL:\n        ch = chords[k % 4]\n        dur = clen + 1.5\n        m = int(dur * SR)\n        tt = np.arange(m) / SR\n        pad = np.zeros(m)\n        for f in ch:\n            for det in (-0.35, 0.0, 0.35):\n                pad += np.sin(2 * np.pi * (f + det) * tt + rng.uniform(0, 6.28)) * (0.9 if f < 150 else 0.55)\n        e = np.minimum(tt / 1.6, 1) * np.minimum((dur - tt) / 1.5, 1)\n        add(mus, pad * e * (0.75 + 0.25 * np.sin(2 * np.pi * 0.13 * tt + k)) * 0.020, t)\n        t += clen\n        k += 1\n    start, step_in, kit, stats, end = START[\"s2\"], START[\"s3\"], START[\"s7\"], START[\"s12\"], START[\"s13\"]\n    bt, nb = start, 0\n    while bt < end + 0.3:\n        kn = int(0.30 * SR)\n        tk = np.arange(kn) / SR\n        kick = np.sin(2 * np.pi * np.cumsum(48 + 70 * np.exp(-tk * 24)) / SR) * np.exp(-tk * 9)\n        add(mus, kick * (0.5 + 0.3 * (bt > step_in) + 0.1 * (bt > kit)) * 0.34, bt)\n        if nb % 2 == 1 and bt > step_in - 1:\n            hn = int(0.05 * SR)\n            hat = np.diff(np.concatenate([[0], rng.standard_normal(hn) * np.exp(-np.arange(hn) / SR * 80)]))\n            add(mus, hat * 0.05, bt + beat / 2)\n        if nb % 4 == 0:\n            root = chords[int((bt - start) // clen) % 4][0] * 0.5\n            bn = int(beat * 3.5 * SR)\n            tb = np.arange(bn) / SR\n            add(mus, (np.sin(2 * np.pi * root * tb) * np.exp(-tb * 1.4) + 0.3 * np.sin(2 * np.pi * root * 2 * tb) * np.exp(-tb * 3)) * 0.2, bt)\n        bt += beat\n        nb += 1\n    pent = [440.0, 523.25, 587.33, 659.25, 783.99, 880.0]\n    at, ai = step_in, 0\n    while at < end - 0.3:\n        pn = int(0.45 * SR)\n        tp = np.arange(pn) / SR\n        f0 = pent[[0, 2, 4, 3, 5, 3, 2, 1][ai % 8]] * (2 if at > kit else 1)\n        add(mus, (np.sin(2 * np.pi * f0 * tp) + 0.3 * np.sin(2 * np.pi * f0 * 2 * tp)) * np.exp(-tp * 7) * (0.04 + 0.02 * (at > kit)), at)\n        at += beat / 2\n        ai += 1\n    for tw in sorted(set(round(x, 2) for x in ev[\"whoosh\"])):\n        wn = int(0.55 * SR)\n        add(fx, bandnoise(wn, 500, 6000, rng) * np.sin(np.pi * np.linspace(0, 1, wn)) ** 2 * 0.15, tw)\n    for tc in sorted(set(round(x, 2) for x in ev[\"click\"])):\n        cn = int(0.07 * SR)\n        tcn = np.arange(cn) / SR\n        add(fx, np.sin(2 * np.pi * 1850 * tcn) * np.exp(-tcn * 70) * 0.10 + rng.standard_normal(cn) * np.exp(-tcn * 150) * 0.03, tc)\n    for (tt0, dur, nch) in ev[\"type\"]:  # soft keystrokes while text is typed\n        for q in range(nch):\n            tq = tt0 + dur * q / max(nch, 1)\n            cn = int(0.03 * SR)\n            tcn = np.arange(cn) / SR\n            add(fx, rng.standard_normal(cn) * np.exp(-tcn * 220) * 0.035 + np.sin(2 * np.pi * 2600 * tcn) * np.exp(-tcn * 200) * 0.02, tq)\n    for tb in ev[\"bell\"]:\n        bn = int(2.2 * SR)\n        tbn = np.arange(bn) / SR\n        add(fx, np.sin(2 * np.pi * 440 * tbn + np.sin(2 * np.pi * 616 * tbn) * 2.2 * np.exp(-tbn * 2)) * np.exp(-tbn * 1.7) * 0.18, tb)\n        sn = int(0.8 * SR)\n        ts = np.arange(sn) / SR\n        add(fx, np.sin(2 * np.pi * (46 + 40 * np.exp(-ts * 14)) * ts) * np.exp(-ts * 4.5) * 0.38, tb)\n    for tp in ev[\"pay\"]:\n        pn = int(1.4 * SR)\n        tpn = np.arange(pn) / SR\n        add(fx, sum(np.sin(2 * np.pi * f * tpn) for f in (392.0, 493.88, 587.33, 783.99)) * np.exp(-tpn * 2.4) * 0.065, tp)\n        add(fx, np.sin(2 * np.pi * (40 + 50 * np.exp(-tpn * 12)) * tpn) * np.exp(-tpn * 5) * 0.32, tp)\n    for tb, m in ev[\"blip\"]:\n        bn = int(0.5 * SR)\n        tbn = np.arange(bn) / SR\n        add(fx, np.sin(2 * np.pi * [392.0, 440.0, 523.25, 659.25][m] * tbn) * np.exp(-tbn * 6) * 0.10, tb)\n    rn = int(1.2 * SR)\n    add(fx, bandnoise(rn, 300, 7000, rng) * np.linspace(0, 1, rn) ** 2.2 * 0.11, stats - 1.25)\n    for tr in ev[\"resolve\"]:\n        rn = int(4.2 * SR)\n        trn = np.arange(rn) / SR\n        add(fx, sum(np.sin(2 * np.pi * f * trn) for f in (110.0, 220.0, 329.63, 440.0, 659.25)) * np.minimum(trn / 0.6, 1) * np.exp(-trn * 0.55) * 0.06, tr)\n    mix = mus + fx\n    tail = np.ones(n)\n    fs = int((TOTAL - 0.2) * SR)\n    tail[fs:] = np.linspace(1, 0, n - fs)\n    mix = np.tanh(mix * tail * 1.6) / 1.6\n    L, R = mix.copy(), mix.copy()\n    d = int(0.011 * SR)\n    R[d:] = 0.85 * mix[:-d] + 0.15 * mix[d:]\n    L /= np.max(np.abs(L)) / 0.85\n    R /= np.max(np.abs(R)) / 0.85\n    pcm = (np.clip(np.stack([L, R], 1), -1, 1) * 32767).astype(\"<i2\")\n    out = ROOT / \"audio\"\n    out.mkdir(exist_ok=True)\n    with wave.open(str(out / \"mochi-film.wav\"), \"wb\") as w:\n        w.setnchannels(2)\n        w.setsampwidth(2)\n        w.setframerate(SR)\n        w.writeframes(pcm.tobytes())\n\n\nif __name__ == \"__main__\":\n    ev = build()\n    make_audio(ev)\n    (ROOT / \"beat-sheet.json\").write_text(json.dumps({\"width\": W, \"height\": H, \"fps\": FPS, \"duration\": round(TOTAL, 2), \"scenes\": [{\"id\": s[0], \"kind\": s[1], \"start\": s[2], \"dur\": s[3]} for s in SC],\n                                                       \"source\": \"stills and assets recorded from the real app (capture.mjs); copy from cap/job.json\"}, indent=1))\n    print(\"built\", round(TOTAL, 1), \"s\")\n"}},"apiBlockIndex":1,"requestId":"req_011Cg5g5RLyuYAGTPjoiaP8v","requestRef":"416451b0-4936-44a8-b752-fff8d32a703a","requestedModel":"claude-sonnet-5-5","type":"assistant","uuid":"55e8a356-30db-45a1-8552-d4a9a7cdc738","timestamp":"2026-10-16T09:26:20.769Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"d1a90136-ab51-4450-87af-371f07f2f333","userType":"external","entrypoint":"cli","cwd":"/Users/advikdivekar/Desktop/sellcraft/video/mochi-film","sessionId":"159a4645-4bae-4261-ac0b-464a7f4accd7","version":"2.1.300","gitBranch":"HEAD"}
{"type":"file-history-delta","messageId":"55e8a356-30db-45a1-8552-d4a9a7cdc738","snapshotMessageId":"c0ea3210-dbd7-4279-8ea6-7ff5a0f3e9f5","trackingPath":"video/mochi-film/build.py","backup":{"backupFileName":null,"version":1,"backupTime":"2026-10-16T09:26:20.797Z","realParentDir":"/Users/advikdivekar/Desktop/sellcraft/video/mochi-film"},"timestamp":"2026-10-16T09:26:20.808Z"}
{"parentUuid":"55e8a356-30db-45a1-8552-d4a9a7cdc738","isSidechain":false,"promptId":"1e07bc6b-05f3-4073-a24a-7a84e8c87d62","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CsC1AtcMWyCmQvNNETLKH5","type":"tool_result","content":"File created successfully at: /Users/advikdivekar/Desktop/sellcraft/video/mochi-film/build.py (file state is current in your context — no need to Read it back)"}]},"uuid":"155dc2f2-1c86-4ffe-a9dc-613b401020a9","timestamp":"2026-10-16T09:26:20.825Z","toolUseResult":{"type":"create","filePath":"/Users/advikdivekar/Desktop/sellcraft/video/mochi-film/build.py","content":"\"\"\"Mochi product film: one fast-paced 16:9 guide (upload -> check -> style -> generate -> share), results and benefits.\n\n   ../../backend/.venv/bin/python build.py     # writes project/index.html, beat-sheet.json, audio/mochi-film.wav\n\nStyle: calm light canvas and device frames (Amii reference), mono step menus, red-vs-blue contrast and big numbers (Scaledown reference),\noversized type with solid pill highlights and a brand reveal (Taste Skill reference), in the Mochi palette.\nFootage: clean stills and assets recorded from the REAL app by capture.mjs. All on-screen copy comes from that run (cap/job.json).\nSound is generated procedurally (numpy): nothing to license.\"\"\"\nimport json\nimport wave\nfrom pathlib import Path\n\nimport numpy as np\n\nROOT = Path(__file__).parent\nW, H, FPS = 1920, 1080, 60\nJOB = json.loads((ROOT / \"cap\" / \"job.json\").read_text())\nCOPY = JOB[\"copy_output\"]\nSHOP = COPY[\"platform_outputs\"][\"shopify\"][\"page_copy\"]\nPIN = COPY[\"platform_outputs\"][\"pinterest\"][\"pin_title\"]\nCAPTION = COPY[\"social_caption\"]\nBUILD_S = json.loads((ROOT / \"cap\" / \"log.json\").read_text())[\"desktopSeconds\"]\n\n\ndef wrap(text, n):\n    out, cur = [], \"\"\n    for w in text.split():\n        if len(cur) + len(w) + 1 > n and cur:\n            out.append(cur)\n            cur = w\n        else:\n            cur = (cur + \" \" + w).strip()\n    if cur:\n        out.append(cur)\n    return out\n\n\ndef words(t):\n    return \"\".join(f'<span class=\"w\">{w}&nbsp;</span>' for w in t.split(\" \"))\n\n\n# ---------------- scene table (timings drive both the video and the soundtrack) ----------------\nSC = [\n    (\"s1\", \"hook\", 0.0, 3.6),\n    (\"s2\", \"title\", 3.6, 3.2),\n    (\"s3\", \"step\", 6.8, 3.6),\n    (\"s4\", \"step\", 10.4, 3.2),\n    (\"s5\", \"step\", 13.6, 3.2),\n    (\"s6\", \"gen\", 16.8, 4.4),\n    (\"s7\", \"kit\", 21.2, 3.8),\n    (\"s8\", \"phone\", 25.0, 4.0),\n    (\"s9\", \"copy\", 29.0, 4.4),\n    (\"s10\", \"trust\", 33.4, 3.8),\n    (\"s11\", \"benefits\", 37.2, 3.6),\n    (\"s12\", \"stats\", 40.8, 4.2),\n    (\"s13\", \"end\", 45.0, 3.8),\n]\nTOTAL = SC[-1][2] + SC[-1][3]\nSTART = {s[0]: s[2] for s in SC}\n\nCSS = \"\"\"\n@font-face { font-family: \"Geist\"; src: url(\"assets/fonts/Geist.woff2\") format(\"woff2\"); font-weight: 300 700; }\n@font-face { font-family: \"Geist Mono\"; src: url(\"assets/fonts/GeistMono.woff2\") format(\"woff2\"); font-weight: 400 500; }\n@font-face { font-family: \"Manrope\"; src: url(\"assets/fonts/Manrope.woff2\") format(\"woff2\"); font-weight: 600 800; }\n* { margin: 0; padding: 0; box-sizing: border-box; }\n:root { --ocean:#003135; --teal:#024950; --turq:#0FA4AF; --turq-d:#037A84; --ice:#AFDDE5; --paper:#F5F8F8; --terra:#964734; --ink:#082F33; --muted:#60777A; }\nhtml, body { width: 1920px; height: 1080px; overflow: hidden; background: #F5F8F8; font-family: \"Geist\", Helvetica, Arial, sans-serif; }\n#root { position: relative; width: 1920px; height: 1080px; overflow: hidden; }\n.scene { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; overflow: hidden; }\n.light { background: radial-gradient(1500px 900px at 80% 8%, #DCEBE6 0%, #EEF4F2 42%, #F5F8F8 100%); color: var(--ink); }\n.dark { background: radial-gradient(1400px 900px at 75% 15%, #035560 0%, #024950 40%, #003135 100%); color: #fff; }\n.mono { font-family: \"Geist Mono\", ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }\n.big { font-weight: 600; letter-spacing: -.04em; line-height: 1.02; }\n.abs { position: absolute; }\n.w { display: inline-block; white-space: pre; }\n.col { position: absolute; display: flex; flex-direction: column; }\n.pill { display: inline-block; background: var(--ocean); color: #fff; border-radius: 18px; padding: 0 26px; }\n.pill.t { background: var(--terra); }\n.chip { display: inline-flex; align-items: center; gap: 12px; border-radius: 40px; font-weight: 500; white-space: nowrap; height: 58px; padding: 0 26px; font-size: 26px; background: rgba(8,47,51,.07); color: var(--ink); box-shadow: inset 0 0 0 1.5px rgba(8,47,51,.14); }\n.chip i { width: 11px; height: 11px; border-radius: 50%; background: var(--turq-d); display: inline-block; }\n.bug { position: absolute; left: 110px; top: 58px; display: flex; align-items: center; gap: 14px; }\n.bug img { width: 46px; height: 46px; border-radius: 28%; }\n.bug b { font-family: \"Manrope\", sans-serif; font-weight: 800; font-size: 34px; letter-spacing: -.04em; text-transform: lowercase; }\n.dots { position: absolute; left: 110px; bottom: 74px; display: flex; gap: 12px; align-items: center; }\n.dots i { width: 14px; height: 14px; border-radius: 50%; background: rgba(8,47,51,.18); }\n.dots i.on { background: var(--turq-d); width: 44px; border-radius: 8px; }\n.win { position: absolute; left: 700px; top: 166px; width: 1120px; height: 749px; border-radius: 26px; overflow: hidden; background: #003135; box-shadow: 0 50px 110px -44px rgba(0,49,53,.55), 0 0 0 1.5px rgba(8,47,51,.12); }\n.win .bar { position: absolute; left: 0; top: 0; right: 0; height: 36px; background: #022a2e; display: flex; align-items: center; gap: 9px; padding-left: 18px; z-index: 3; }\n.win .bar i { width: 12px; height: 12px; border-radius: 50%; background: rgba(175,221,229,.3); display: block; }\n.win .view { position: absolute; left: 0; top: 36px; width: 1120px; height: 713px; overflow: hidden; }\n.win img { position: absolute; left: 0; top: 0; transform-origin: 0 0; display: block; max-width: none; }\n.num { font-family: \"Manrope\", sans-serif; font-weight: 800; letter-spacing: -.05em; }\n.wipe { position: absolute; top: 0; width: 120px; height: 1080px; background: var(--turq); z-index: 90; left: -140px; }\n\"\"\"\n\n\ndef build():\n    html, js, ev = [], [], {\"whoosh\": [], \"click\": [], \"bell\": [], \"blip\": [], \"pay\": [], \"resolve\": [], \"type\": []}\n\n    def bug(sid, dark=False):\n        col = \"#fff\" if dark else \"var(--ink)\"\n        return f'<div id=\"{sid}bug\" class=\"bug\" style=\"color:{col}\"><img src=\"assets/brand/mochi-tile.png\"><b>mochi</b></div>'\n\n    def dots(sid, n, total=5):\n        return f'<div id=\"{sid}dots\" class=\"dots\">' + \"\".join(f'<i class=\"{\"on\" if k == n else \"\"}\"></i>' for k in range(total)) + \"</div>\"\n\n    def window(sid, stills):\n        \"\"\"stills: [(file, at, dur, (rx,ry,rw) from, (rx,ry,rw) to)] in source px (2200x1400). View area is 1120x713.\"\"\"\n        h = [f'<div id=\"{sid}w\" class=\"win\"><div class=\"bar\"><i></i><i></i><i></i></div><div class=\"view\">']\n        for n, st in enumerate(stills):\n            h.append(f'<img id=\"{sid}i{n}\" src=\"assets/s/{st[0]}.jpg\" style=\"width:2200px; height:1400px\">')\n        h.append(\"</div></div>\")\n        t0 = START[sid]\n        js.append(f'  tl.from(\"#{sid}w\", {{ opacity: 0, x: 90, duration: 0.55, ease: \"power3.out\" }}, {t0 + 0.05:.2f});')\n        for n, (name, at, dur, a, b) in enumerate(stills):\n            s0, s1 = 1120 / a[2], 1120 / b[2]\n            tin = t0 + at\n            span = dur + (0.3 if n < len(stills) - 1 else 0)\n            js.append(f'  gsap.set(\"#{sid}i{n}\", {{ x: {-a[0] * s0:.2f}, y: {-a[1] * s0:.2f}, scale: {s0:.4f}, opacity: {1 if n == 0 else 0} }});')\n            if n > 0:\n                js.append(f'  tl.to(\"#{sid}i{n}\", {{ opacity: 1, duration: 0.25 }}, {tin:.2f});')\n                ev[\"click\"].append(tin)\n            js.append(f'  tl.to(\"#{sid}i{n}\", {{ x: {-b[0] * s1:.2f}, y: {-b[1] * s1:.2f}, scale: {s1:.4f}, duration: {span:.2f}, ease: \"power2.inOut\" }}, {tin:.2f});')\n        return \"\".join(h)\n\n    def scene_open(sid, kind, theme):\n        s = next(x for x in SC if x[0] == sid)\n        return f'<div id=\"{sid}\" class=\"clip scene {theme}\" data-start=\"{s[2]}\" data-duration=\"{s[3]}\" data-track-index=\"0\">'\n\n    def reveal(i, t, gap=0.07):\n        js.append(f'  reveal(\"{i}\", {t:.2f}, {gap});')\n\n    # ---------- S1: the problem (Scaledown-style) ----------\n    t0 = START[\"s1\"]\n    html.append(scene_open(\"s1\", \"hook\", \"light\") + bug(\"s1\") +\n                f'<div id=\"s1p\" class=\"abs\" style=\"left:110px; top:150px; width:540px; height:790px; border-radius:26px; overflow:hidden; box-shadow:0 50px 100px -44px rgba(0,49,53,.5)\"><img id=\"s1pi\" src=\"assets/s/photo-front.jpg\" style=\"width:100%; height:100%; object-fit:cover; transform-origin:50% 50%\"></div>'\n                f'<div id=\"s1h\" class=\"abs big\" style=\"left:760px; top:170px; width:1050px; font-size:118px\">{words(\"SO WHY IS IT\")}<br>{words(\"STILL\")}<span class=\"w\" id=\"s1x\" style=\"color:var(--terra)\">FOUR&nbsp;JOBS?</span></div>'\n                f'<div id=\"s1q\" class=\"abs mono\" style=\"left:760px; top:470px; font-size:26px; color:var(--muted); letter-spacing:.06em\">One product. Photos, copy, posts, video: four tools.</div>'\n                + \"\".join(f'<div id=\"s1b{n}\" class=\"abs\" style=\"left:{760 + n * 268}px; top:560px; width:248px; height:150px; border-radius:18px; background:#fff; box-shadow:0 0 0 1.5px rgba(8,47,51,.1), 0 30px 60px -36px rgba(0,49,53,.4); padding:22px\"><div class=\"mono\" style=\"font-size:19px; color:var(--muted)\">{lab}</div><div class=\"mono\" style=\"font-size:21px; color:var(--terra); margin-top:12px\">to do</div><div style=\"margin-top:18px; height:8px; border-radius:4px; background:#E2ECEC\"><div id=\"s1f{n}\" style=\"height:8px; width:0; border-radius:4px; background:var(--terra)\"></div></div></div>' for n, lab in enumerate([\"PHOTOS\", \"COPY\", \"POSTS\", \"VIDEO\"])) +\n                '</div>')\n    js.append(\"  // s1\")\n    js.append(f'  tl.from(\"#s1p\", {{ opacity: 0, y: 60, duration: 0.6, ease: \"power3.out\" }}, 0.05); tl.fromTo(\"#s1pi\", {{ scale: 1.0 }}, {{ scale: 1.12, duration: {SC[0][3]}, ease: \"none\" }}, 0);')\n    reveal(\"s1h\", 0.2, 0.08)\n    js.append('  tl.from(\"#s1q\", { opacity: 0, y: 16, duration: 0.4 }, 1.0);')\n    for n in range(4):\n        tt = 1.15 + n * 0.28\n        js.append(f'  tl.from(\"#s1b{n}\", {{ opacity: 0, y: 40, duration: 0.45, ease: \"power3.out\" }}, {tt:.2f}); tl.to(\"#s1f{n}\", {{ width: {[38, 22, 31, 14][n]}, duration: 1.9, ease: \"none\" }}, {tt + 0.3:.2f});')\n        ev[\"click\"].append(tt)\n    ev[\"pay\"].append(0.2)\n\n    # ---------- S2: title + step menu (Taste + Scaledown) ----------\n    t0 = START[\"s2\"]\n    steps = [\"Upload\", \"Check\", \"Style\", \"Generate\", \"Share\"]\n    menu = \"\".join(f'<div id=\"s2m{n}\" class=\"abs mono\" style=\"left:0; top:{n * 96}px; width:520px; height:84px; line-height:84px; font-size:38px; padding-left:28px; color:var(--ink); overflow:hidden\"><div id=\"s2hl{n}\" class=\"abs\" style=\"left:0; top:0; height:84px; width:0; background:var(--turq-d); border-radius:6px\"></div><span style=\"position:relative\">[0{n + 1}] {s}</span></div>' for n, s in enumerate(steps))\n    html.append(scene_open(\"s2\", \"title\", \"light\") + bug(\"s2\") +\n                f'<div id=\"s2t\" class=\"abs big\" style=\"left:100px; top:200px; width:1000px; font-size:176px; line-height:.98\">{words(\"One photo.\")}<br>{words(\"One tap.\")}<br><span class=\"w\" style=\"color:var(--turq-d)\">A&nbsp;whole&nbsp;kit.</span></div>'\n                f'<div id=\"s2menu\" class=\"abs\" style=\"left:1290px; top:290px; width:520px; height:480px\">{menu}</div>'\n                f'<div id=\"s2k\" class=\"abs mono\" style=\"left:1318px; top:236px; font-size:22px; color:var(--muted)\">Five steps</div></div>')\n    js.append(\"  // s2\")\n    reveal(\"s2t\", t0 + 0.08, 0.09)\n    js.append(f'  tl.from(\"#s2k\", {{ opacity: 0, duration: 0.3 }}, {t0 + 0.3:.2f});')\n    for n in range(5):\n        tt = t0 + 0.45 + n * 0.42\n        js.append(f'  tl.from(\"#s2m{n}\", {{ opacity: 0, x: 40, duration: 0.35 }}, {t0 + 0.3 + n * 0.08:.2f}); tl.to(\"#s2hl{n}\", {{ width: 520, duration: 0.28, ease: \"power3.out\" }}, {tt:.2f}); tl.to(\"#s2m{n}\", {{ color: \"#fff\", duration: 0.2 }}, {tt:.2f});')\n        if n < 4:\n            js.append(f'  tl.to(\"#s2hl{n}\", {{ opacity: 0, duration: 0.2 }}, {tt + 0.42:.2f}); tl.to(\"#s2m{n}\", {{ color: \"#082F33\", duration: 0.2 }}, {tt + 0.42:.2f});')\n        ev[\"click\"].append(tt)\n\n    # ---------- S3-S5: the first three steps ----------\n    step_cfg = [\n        (\"s3\", 0, \"[01] Upload\", \"Add up to five photos.\", [\"Reads the label\", \"Pre-fills the facts\"],\n         [(\"d-01-photos\", 0.0, 1.9, (40, 200, 1660), (40, 160, 1500)), (\"d-02-scanned\", 1.8, 1.8, (40, 200, 1660), (1440, 440, 760))]),\n        (\"s4\", 1, \"[02] Check\", \"Check what it read.\", [\"From photo · check it\", \"Blank means flagged, not guessed\"],\n         [(\"d-03-facts\", 0.0, 1.5, (40, 140, 1660), (40, 130, 1500)), (\"d-04-facts2\", 1.4, 1.8, (40, 0, 1660), (60, 90, 1450))]),\n        (\"s5\", 2, \"[03] Style\", \"Pick platform, tone and style.\", [\"5 platforms\", \"6 tones\", \"5 visual styles\"],\n         [(\"d-05-style\", 0.0, 1.5, (40, 130, 1660), (40, 160, 1500)), (\"d-06-style2\", 1.4, 1.8, (40, 0, 1660), (60, 40, 1450))]),\n    ]\n    for sid, idx, label, title, chips, stills in step_cfg:\n        t0 = START[sid]\n        ch = \"\".join(f'<div id=\"{sid}c{n}\" class=\"chip\"><i></i>{c}</div>' for n, c in enumerate(chips))\n        html.append(scene_open(sid, \"step\", \"light\") + bug(sid) +\n                    f'<div class=\"col\" style=\"left:110px; top:180px; width:540px; height:700px; gap:30px; justify-content:center\">'\n                    f'<div id=\"{sid}k\" class=\"mono\" style=\"font-size:26px; color:var(--turq-d)\">{label}</div>'\n                    f'<div id=\"{sid}t\" class=\"big\" style=\"font-size:82px\">{words(title)}</div>'\n                    f'<div style=\"display:flex; flex-direction:column; gap:14px; align-items:flex-start; margin-top:10px\">{ch}</div></div>'\n                    + dots(sid, idx) + window(sid, stills) + \"</div>\")\n        js.append(f\"  // {sid}\")\n        js.append(f'  tl.from(\"#{sid}k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f});')\n        reveal(sid + \"t\", t0 + 0.12, 0.07)\n        for n in range(len(chips)):\n            tt = t0 + 0.55 + n * 0.3\n            js.append(f'  tl.from(\"#{sid}c{n}\", {{ opacity: 0, y: 22, duration: 0.35 }}, {tt:.2f});')\n            ev[\"click\"].append(tt)\n\n    # ---------- S6: generate (counter + build states) ----------\n    t0 = START[\"s6\"]\n    stills = [(\"d-07-build-0\", 0.0, 0.9, (260, 40, 1700), (300, 60, 1600)), (\"d-07-build-1\", 0.8, 0.9, (260, 40, 1700), (300, 60, 1600)),\n              (\"d-07-build-2\", 1.6, 0.9, (260, 40, 1700), (300, 60, 1600)), (\"d-07-build-3\", 2.4, 0.9, (260, 40, 1700), (300, 60, 1600)),\n              (\"d-08-results\", 3.2, 1.2, (0, 0, 2200), (40, 340, 1500))]\n    html.append(scene_open(\"s6\", \"gen\", \"light\") + bug(\"s6\") +\n                f'<div class=\"col\" style=\"left:110px; top:180px; width:540px; height:700px; gap:14px; justify-content:center\">'\n                f'<div id=\"s6k\" class=\"mono\" style=\"font-size:26px; color:var(--turq-d)\">[04] Generate</div>'\n                f'<div id=\"s6t\" class=\"big\" style=\"font-size:82px\">{words(\"One tap.\")}</div>'\n                f'<div id=\"s6n\" class=\"num\" style=\"position:relative; height:250px; font-size:250px; line-height:1; color:var(--ink); margin-top:8px\"></div>'\n                f'<div id=\"s6c\" class=\"chip\" style=\"margin-top:6px\"><i></i>Fast mode · Gemma 3, on your machine</div></div>'\n                + dots(\"s6\", 3) + window(\"s6\", stills) + \"</div>\")\n    js.append(\"  // s6\")\n    js.append(f'  tl.from(\"#s6k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f});')\n    reveal(\"s6t\", t0 + 0.12, 0.07)\n    js.append(f'  tl.from(\"#s6c\", {{ opacity: 0, y: 20, duration: 0.35 }}, {t0 + 0.7:.2f});')\n    cnt = BUILD_S\n    for k in range(cnt + 1):\n        ta = t0 + 0.3 + (k / (cnt + 1)) * 3.5\n        tb = t0 + 0.3 + ((k + 1) / (cnt + 1)) * 3.5\n        hide = f'tl.set(e, {{ visibility: \"hidden\" }}, {tb:.3f});' if k < cnt else \"\"\n        js.append(f\"  {{ const e = mk('s6n', '{k}<small style=\\\"font-size:.28em;color:#037A84;margin-left:10px;letter-spacing:0\\\">s</small>'); tl.set(e, {{ visibility: 'visible' }}, {ta:.3f}); {hide} }}\")\n    ev[\"pay\"].append(t0 + 3.3)\n\n    # ---------- S7: the kit (cards align into a grid) ----------\n    t0 = START[\"s7\"]\n    ctitle = COPY[\"product_title\"]\n    tiles = [\n        (\"VIDEO AD · 10 s\", 110, 304, '<div style=\"width:100%; height:100%; background:#000\"><img src=\"assets/s/deck_slide-1.jpg\" style=\"width:100%; height:100%; object-fit:cover\"></div>', \"vid\"),\n        (\"IMAGE DECK · 7 slides\", 439, 440, '<img src=\"assets/s/deck_slide-2.jpg\" style=\"width:100%; height:100%; object-fit:cover\">', \"deck\"),\n        (\"STUDIO PHOTOS · 5\", 904, 440, '<img src=\"assets/s/studio_image-2.jpg\" style=\"width:100%; height:100%; object-fit:cover\">', \"stu\"),\n        (\"COPY · 3 platforms\", 1369, 440, f'<div style=\"padding:70px 34px 34px; color:var(--ink)\"><div class=\"mono\" style=\"font-size:18px; color:var(--turq-d)\">Shopify · page copy</div><div style=\"font-size:32px; font-weight:600; letter-spacing:-.02em; margin-top:14px; line-height:1.15\">{ctitle}</div><div style=\"font-size:23px; color:var(--muted); line-height:1.4; margin-top:16px\">{SHOP}</div></div>', \"copy\"),\n    ]\n    th = []\n    for n, (lab, x, w, inner, key) in enumerate(tiles):\n        th.append(f'<div id=\"s7t{n}\" class=\"abs\" style=\"left:{x}px; top:410px; width:{w}px; height:540px; border-radius:24px; overflow:hidden; background:#fff; box-shadow:0 0 0 1.5px rgba(8,47,51,.1), 0 40px 80px -44px rgba(0,49,53,.5)\">{inner}'\n                  f'<div class=\"mono abs\" style=\"left:14px; top:14px; font-size:17px; color:#fff; background:var(--ocean); border-radius:20px; padding:9px 16px\">{lab}</div></div>')\n    html.append(scene_open(\"s7\", \"kit\", \"light\") + bug(\"s7\") +\n                f'<div id=\"s7k\" class=\"abs mono\" style=\"left:110px; top:150px; font-size:26px; color:var(--turq-d)\">05 · Your kit</div>'\n                f'<div id=\"s7t\" class=\"abs big\" style=\"left:110px; top:200px; width:1500px; font-size:96px\">{words(\"Everything in one kit.\")}</div>'\n                + \"\".join(th) + dots(\"s7\", 3) + \"</div>\")\n    js.append(\"  // s7\")\n    js.append(f'  tl.from(\"#s7k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f});')\n    reveal(\"s7t\", t0 + 0.12, 0.07)\n    for n in range(4):\n        tt = t0 + 0.7 + n * 0.34\n        js.append(f'  tl.from(\"#s7t{n}\", {{ opacity: 0, y: 90, duration: 0.55, ease: \"power3.out\" }}, {tt:.2f});')\n        ev[\"click\"].append(tt)\n\n    # ---------- S8: the video ad on a phone (Amii) ----------\n    t0 = START[\"s8\"]\n    html.append(scene_open(\"s8\", \"phone\", \"light\") + bug(\"s8\") +\n                '<div id=\"s8p\" class=\"abs\" style=\"left:330px; top:104px; width:490px; height:872px; border-radius:68px; background:#021f22; box-shadow:0 70px 130px -50px rgba(0,49,53,.6), 0 0 0 2px rgba(8,47,51,.2)\"></div>'\n                f'<div class=\"col\" style=\"left:960px; top:250px; width:860px; gap:28px\">'\n                f'<div id=\"s8k\" class=\"mono\" style=\"font-size:26px; color:var(--turq-d)\">On your phone</div>'\n                f'<div id=\"s8t\" class=\"big\" style=\"font-size:104px\">{words(\"A 10-second\")}<br>{words(\"vertical ad.\")}</div>'\n                f'<div id=\"s8s\" style=\"font-size:34px; line-height:1.35; color:var(--muted); width:760px\">Built from your own photos, with real camera moves and text. Image processing and FFmpeg, not generated footage.</div></div></div>')\n    js.append(\"  // s8\")\n    js.append(f'  tl.from(\"#s8p\", {{ opacity: 0, y: 90, duration: 0.65, ease: \"power3.out\" }}, {t0 + 0.05:.2f});')\n    js.append(f'  tl.from(\"#s8k\", {{ opacity: 0, x: 30, duration: 0.35 }}, {t0 + 0.2:.2f}); ')\n    reveal(\"s8t\", t0 + 0.25, 0.08)\n    js.append(f'  tl.from(\"#s8s\", {{ opacity: 0, y: 20, duration: 0.5 }}, {t0 + 0.9:.2f});')\n    ev[\"click\"].append(t0 + 0.9)\n\n    # ---------- S9: copy for each platform (typed, mono) ----------\n    t0 = START[\"s9\"]\n    plats = [(\"Caption\", \"CAPTION\", wrap(CAPTION, 42)), (\"Shopify\", \"SHOPIFY · PAGE COPY\", wrap(SHOP, 42)), (\"Pinterest\", \"PINTEREST · PIN TITLE\", wrap(PIN, 42))]\n    panel = []\n    for n, (nm, lab, lines) in enumerate(plats):\n        ln = \"\".join(f'<div id=\"s9p{n}l{m}\" style=\"position:relative; height:48px; white-space:pre; font-size:31px; font-family:\\'Geist Mono\\',monospace; color:#fff\"><span id=\"s9p{n}t{m}\" style=\"display:inline-block; clip-path:inset(0 100% 0 0)\">{l}</span><i id=\"s9p{n}c{m}\" style=\"position:absolute; left:0; top:6px; width:15px; height:34px; background:var(--turq); opacity:0\"></i></div>' for m, l in enumerate(lines))\n        panel.append(f'<div id=\"s9p{n}\" class=\"abs\" style=\"left:56px; top:56px; width:1000px; height:560px; opacity:0\"><div class=\"mono\" style=\"font-size:21px; color:var(--ice); margin-bottom:26px\">{lab}</div>{ln}</div>')\n    menu = \"\".join(f'<div id=\"s9m{n}\" class=\"abs mono\" style=\"left:0; top:{n * 92}px; width:500px; height:80px; line-height:80px; font-size:34px; padding-left:26px; color:var(--ink); overflow:hidden\"><div id=\"s9hl{n}\" class=\"abs\" style=\"left:0; top:0; height:80px; width:0; background:var(--turq-d); border-radius:6px\"></div><span style=\"position:relative\">{nm}</span></div>' for n, (nm, _, _) in enumerate(plats))\n    html.append(scene_open(\"s9\", \"copy\", \"light\") + bug(\"s9\") +\n                f'<div id=\"s9k\" class=\"abs mono\" style=\"left:110px; top:180px; font-size:26px; color:var(--turq-d)\">06 · Copy</div>'\n                f'<div id=\"s9t\" class=\"abs big\" style=\"left:110px; top:232px; width:560px; font-size:82px\">{words(\"Copy for every platform.\")}</div>'\n                f'<div id=\"s9menu\" class=\"abs\" style=\"left:110px; top:620px; width:500px; height:290px\">{menu}</div>'\n                f'<div id=\"s9win\" class=\"abs\" style=\"left:700px; top:166px; width:1120px; height:749px; border-radius:28px; background:#003135; box-shadow:0 50px 110px -44px rgba(0,49,53,.55)\">' + \"\".join(panel) + '</div>'\n                + dots(\"s9\", 3) + \"</div>\")\n    js.append(\"  // s9\")\n    js.append(f'  tl.from(\"#s9k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f}); tl.from(\"#s9win\", {{ opacity: 0, x: 90, duration: 0.55, ease: \"power3.out\" }}, {t0 + 0.05:.2f});')\n    reveal(\"s9t\", t0 + 0.12, 0.07)\n    per = 1.35\n    for n, (nm, lab, lines) in enumerate(plats):\n        ts = t0 + 0.6 + n * per\n        js.append(f'  tl.from(\"#s9m{n}\", {{ opacity: 0, x: -30, duration: 0.3 }}, {t0 + 0.4 + n * 0.1:.2f}); tl.to(\"#s9hl{n}\", {{ width: 500, duration: 0.25, ease: \"power3.out\" }}, {ts:.2f}); tl.to(\"#s9m{n}\", {{ color: \"#fff\", duration: 0.2 }}, {ts:.2f});')\n        if n < len(plats) - 1:\n            js.append(f'  tl.to(\"#s9hl{n}\", {{ opacity: 0, duration: 0.2 }}, {ts + per - 0.1:.2f}); tl.to(\"#s9m{n}\", {{ color: \"#082F33\", duration: 0.2 }}, {ts + per - 0.1:.2f});')\n            js.append(f'  tl.to(\"#s9p{n}\", {{ opacity: 0, duration: 0.15 }}, {ts + per - 0.1:.2f});')\n        js.append(f'  tl.set(\"#s9p{n}\", {{ opacity: 1 }}, {ts + 0.05:.2f});')\n        cur = ts + 0.15\n        for m, l in enumerate(lines):\n            dur = min(0.7, 0.012 * len(l) + 0.15)\n            ch_w = 31 * 0.6\n            js.append(f'  tl.fromTo(\"#s9p{n}t{m}\", {{ clipPath: \"inset(0 100% 0 0)\" }}, {{ clipPath: \"inset(0 0% 0 0)\", duration: {dur:.2f}, ease: \"steps({len(l)})\" }}, {cur:.2f});')\n            js.append(f'  tl.set(\"#s9p{n}c{m}\", {{ opacity: 1, x: 0 }}, {cur:.2f}); tl.to(\"#s9p{n}c{m}\", {{ x: {len(l) * ch_w:.1f}, duration: {dur:.2f}, ease: \"steps({len(l)})\" }}, {cur:.2f}); tl.set(\"#s9p{n}c{m}\", {{ opacity: 0 }}, {cur + dur + 0.03:.2f});')\n            ev[\"type\"].append((cur, dur, len(l)))\n            cur += dur + 0.05\n        ev[\"click\"].append(ts)\n\n    # ---------- S10: trust, \"Nothing made up\" ----------\n    t0 = START[\"s10\"]\n    tm = [\"Missing facts listed\", \"Regulated claims flagged\", \"You approve every post\"]\n    items = \"\".join(f'<div id=\"s10m{n}\" class=\"abs\" style=\"left:0; top:{n * 108}px; width:460px; font-size:34px; font-weight:500; line-height:1.15; color:var(--ink); display:flex; align-items:center; gap:18px\"><span style=\"width:16px; height:16px; background:var(--turq-d); border-radius:4px; flex:none\"></span>{m}</div>' for n, m in enumerate(tm))\n    html.append(scene_open(\"s10\", \"trust\", \"light\") + bug(\"s10\") +\n                f'<div id=\"s10k\" class=\"abs mono\" style=\"left:110px; top:180px; font-size:26px; color:var(--turq-d)\">07 · Trust</div>'\n                f'<div id=\"s10menu\" class=\"abs\" style=\"left:110px; top:300px; width:470px; height:360px\">{items}</div>'\n                '<div id=\"s10card\" class=\"abs\" style=\"left:640px; top:170px; width:700px; height:740px; border-radius:30px; overflow:hidden; background:#003135; box-shadow:0 50px 110px -44px rgba(0,49,53,.6)\">'\n                '<img id=\"s10i\" src=\"assets/s/d-10-insights.jpg\" style=\"position:absolute; left:0; top:0; width:2200px; height:1400px; transform-origin:0 0\"></div>'\n                f'<div id=\"s10h\" class=\"abs big\" style=\"left:1400px; top:300px; width:460px; font-size:128px; line-height:.98\">{words(\"Nothing\")}<br>{words(\"made up.\")}</div>'\n                + dots(\"s10\", 4) + \"</div>\")\n    js.append(\"  // s10\")\n    js.append(f'  tl.from(\"#s10k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f}); tl.from(\"#s10card\", {{ opacity: 0, y: 70, duration: 0.6, ease: \"power3.out\" }}, {t0 + 0.1:.2f});')\n    sa, sb = 700 / 1050, 700 / 760\n    js.append(f'  gsap.set(\"#s10i\", {{ x: {-30 * sa:.2f}, y: {-760 * sa:.2f}, scale: {sa:.4f} }}); tl.to(\"#s10i\", {{ x: {-40 * sb:.2f}, y: {-870 * sb:.2f}, scale: {sb:.4f}, duration: {SC[9][3] - 0.2:.2f}, ease: \"power2.inOut\" }}, {t0 + 0.1:.2f});')\n    reveal(\"s10h\", t0 + 0.3, 0.12)\n    for n in range(3):\n        tt = t0 + 0.7 + n * 0.5\n        js.append(f'  tl.from(\"#s10m{n}\", {{ opacity: 0, x: -30, duration: 0.4 }}, {tt:.2f});')\n        ev[\"click\"].append(tt)\n\n    # ---------- S11: benefits (editorial pills) ----------\n    t0 = START[\"s11\"]\n    lines = [(\"Runs on your\", \"machine.\"), (\"Built on\", \"open models.\"), (\"No per-kit\", \"fees.\"), (\"Posts only\", \"when you tap.\")]\n    rows = \"\".join(f'<div id=\"s11r{n}\" class=\"abs big\" style=\"left:110px; top:{190 + n * 200}px; font-size:128px; white-space:nowrap\">{a} <span class=\"pill\" id=\"s11p{n}\" style=\"{\"\" if n % 2 == 0 else \"background:var(--terra)\"}\"><span id=\"s11pt{n}\" style=\"display:inline-block\">{b}</span></span></div>' for n, (a, b) in enumerate(lines))\n    html.append(scene_open(\"s11\", \"benefits\", \"light\") + bug(\"s11\") + f'<div id=\"s11k\" class=\"abs mono\" style=\"left:110px; top:136px; font-size:24px; color:var(--turq-d)\">08 · Why it matters</div>' + rows + \"</div>\")\n    js.append(\"  // s11\")\n    js.append(f'  tl.from(\"#s11k\", {{ opacity: 0, duration: 0.3 }}, {t0 + 0.05:.2f});')\n    for n in range(4):\n        tt = t0 + 0.25 + n * 0.62\n        js.append(f'  tl.from(\"#s11r{n}\", {{ opacity: 0, x: -80, duration: 0.5, ease: \"power3.out\" }}, {tt:.2f}); tl.from(\"#s11p{n}\", {{ clipPath: \"inset(0 100% 0 0)\", duration: 0.45, ease: \"power3.out\" }}, {tt + 0.25:.2f});')\n        ev[\"click\"].append(tt + 0.3)\n\n    # ---------- S12: results on dark (Scaledown big numbers) ----------\n    t0 = START[\"s12\"]\n    html.append(scene_open(\"s12\", \"stats\", \"dark\") +\n                f'<div id=\"s12k\" class=\"abs mono\" style=\"left:110px; top:130px; font-size:26px; color:var(--ice)\">09 · Results</div>'\n                f'<div id=\"s12a\" class=\"abs\" style=\"left:110px; top:250px; width:1150px\"><div class=\"num\" style=\"font-size:230px; line-height:1; color:#fff\">18<span style=\"font-size:.5em\">%</span> <span style=\"color:var(--turq)\">→</span> 88<span style=\"font-size:.5em\">%</span></div><div class=\"mono\" style=\"font-size:24px; color:var(--ice); margin-top:18px\">Clean kits · untuned model vs Mochi fine-tune</div></div>'\n                f'<div id=\"s12b\" class=\"abs\" style=\"left:1330px; top:250px; width:520px\"><div class=\"num\" style=\"font-size:230px; line-height:1; color:#fff\">{BUILD_S}<span style=\"font-size:.5em; color:var(--turq)\">s</span></div><div class=\"mono\" style=\"font-size:24px; color:var(--ice); margin-top:18px\">Whole kit · fast mode</div></div>'\n                f'<div id=\"s12c\" class=\"abs\" style=\"left:110px; top:760px; width:1500px; font-size:28px; line-height:1.4; color:rgba(175,221,229,.9)\">60 held-out tests · deterministic checker · an independent judge (n=30) shows a smaller gain · measured on a synthetic test set</div>'\n                f'<div id=\"s12bar\" class=\"abs\" style=\"left:110px; top:700px; width:0; height:6px; background:var(--terra); border-radius:3px\"></div></div>')\n    js.append(\"  // s12\")\n    js.append(f'  tl.from(\"#s12k\", {{ opacity: 0, duration: 0.3 }}, {t0 + 0.05:.2f}); tl.from(\"#s12a\", {{ opacity: 0, y: 60, duration: 0.55, ease: \"power3.out\" }}, {t0 + 0.2:.2f}); tl.from(\"#s12b\", {{ opacity: 0, y: 60, duration: 0.55, ease: \"power3.out\" }}, {t0 + 0.9:.2f});')\n    js.append(f'  tl.to(\"#s12bar\", {{ width: 300, duration: 0.6 }}, {t0 + 1.6:.2f}); tl.from(\"#s12c\", {{ opacity: 0, y: 20, duration: 0.5 }}, {t0 + 1.9:.2f});')\n    ev[\"blip\"].extend([(t0 + 0.7, 2), (t0 + 1.4, 3)])\n\n    # ---------- S13: end card ----------\n    t0 = START[\"s13\"]\n    html.append(scene_open(\"s13\", \"end\", \"dark\") +\n                '<div id=\"s13l\" class=\"abs\" style=\"left:0; width:1920px; top:290px; display:flex; justify-content:center; align-items:center; gap:34px\"><img src=\"assets/brand/mochi-tile.png\" style=\"width:150px; height:150px; border-radius:28%; box-shadow:0 30px 70px -26px rgba(0,0,0,.6)\"><b style=\"font-family:Manrope,sans-serif; font-weight:800; font-size:150px; letter-spacing:-.04em; text-transform:lowercase; color:#fff; line-height:1\">mochi</b></div>'\n                f'<div id=\"s13a\" class=\"abs big\" style=\"left:0; width:1920px; text-align:center; top:520px; font-size:84px; color:#fff\">{words(\"One photo. A whole marketing kit.\")}</div>'\n                '<div id=\"s13b\" class=\"abs\" style=\"left:0; width:1920px; text-align:center; top:660px; font-size:42px; color:var(--ice)\">Built with open models. Designed around your workflow.</div>'\n                '<div id=\"s13bar\" class=\"abs\" style=\"left:820px; top:745px; width:0; height:6px; background:var(--terra); border-radius:3px\"></div>'\n                '<div id=\"s13u\" class=\"abs mono\" style=\"left:0; width:1920px; text-align:center; top:790px; font-size:28px; color:#fff\">Open source · github.com/advikdivekar/sellcraft</div></div>')\n    js.append(\"  // s13\")\n    js.append(f'  tl.from(\"#s13l\", {{ opacity: 0, scale: 0.9, duration: 0.65, ease: \"power3.out\" }}, {t0 + 0.05:.2f});')\n    reveal(\"s13a\", t0 + 0.6, 0.09)\n    js.append(f'  tl.from(\"#s13b\", {{ opacity: 0, y: 20, duration: 0.5 }}, {t0 + 1.4:.2f}); tl.to(\"#s13bar\", {{ width: 280, duration: 0.5 }}, {t0 + 1.8:.2f}); tl.from(\"#s13u\", {{ opacity: 0, y: 16, duration: 0.5 }}, {t0 + 2.1:.2f});')\n    ev[\"bell\"].extend([START[\"s2\"] + 0.1, t0 + 0.1])\n    ev[\"resolve\"].append(t0 + 0.1)\n\n    # ---------- scene-boundary wipes + whooshes ----------\n    wipes = []\n    for sid, kind, st, du in SC[1:]:\n        wipes.append(f'<div id=\"wp{sid}\" class=\"wipe\"></div>')\n        js.append(f'  tl.fromTo(\"#wp{sid}\", {{ x: 0 }}, {{ x: 2180, duration: 0.42, ease: \"power2.inOut\" }}, {st - 0.21:.2f});')\n        ev[\"whoosh\"].append(st - 0.2)\n    video = (f'<video id=\"adv\" class=\"clip\" data-start=\"{START[\"s8\"] + 0.45}\" data-duration=\"4.5\" data-track-index=\"2\" muted playsinline src=\"assets/ad-clip.mp4\" '\n             'style=\"position:absolute; left:352px; top:126px; width:446px; height:828px; border-radius:48px; object-fit:cover; z-index:5\"></video>')\n    page = f'''<!doctype html>\n<html lang=\"en\" data-resolution=\"landscape\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=1920, height=1080\" />\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n<style>{CSS}</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-start=\"0\" data-duration=\"{TOTAL:.2f}\" data-width=\"1920\" data-height=\"1080\" data-fps=\"60\">\n{chr(10).join(html)}\n{video}\n{chr(10).join(wipes)}\n<script>\n(function () {{\n  const tl = gsap.timeline({{ paused: true }});\n  const reveal = function (id, t, gap) {{ document.querySelectorAll(\"#\" + id + \" .w\").forEach(function (w, i) {{ tl.from(w, {{ opacity: 0, y: 44, duration: 0.5, ease: \"power3.out\" }}, t + i * gap); }}); }};\n  const mk = function (id, markup) {{ const el = document.createElement(\"span\"); el.innerHTML = markup; el.style.cssText = \"position:absolute;left:0;top:0;visibility:hidden;white-space:nowrap\"; document.getElementById(id).appendChild(el); return el; }};\n{chr(10).join(js)}\n  window.__timelines = window.__timelines || {{}};\n  window.__timelines[\"main\"] = tl;\n  tl.seek(0);\n}})();\n</script>\n</div>\n</body>\n</html>'''\n    (ROOT / \"project\" / \"index.html\").write_text(page)\n    return ev\n\n\n# ---------------- procedural soundtrack ----------------\nSR = 48000\n\n\ndef add(buf, sig, t):\n    i = int(t * SR)\n    if i < 0 or i >= len(buf):\n        return\n    j = min(len(buf), i + len(sig))\n    buf[i:j] += sig[: j - i]\n\n\ndef bandnoise(n, f0, f1, rng):\n    out = np.zeros(n + 4096)\n    c = 2048\n    win = np.hanning(c)\n    noise = rng.standard_normal(n + c * 2)\n    for s in range(0, n, c // 2):\n        seg = noise[s: s + c]\n        if len(seg) < c:\n            break\n        sp = np.fft.rfft(seg * win)\n        f = np.fft.rfftfreq(c, 1 / SR)\n        ctr = f0 * (f1 / f0) ** (s / n)\n        sp *= np.exp(-0.5 * ((np.log2(f + 1) - np.log2(ctr)) / 0.9) ** 2)\n        out[s: s + c] += np.fft.irfft(sp) * win\n    out = out[:n]\n    return out / (np.max(np.abs(out)) + 1e-9)\n\n\ndef make_audio(ev):\n    rng = np.random.default_rng(11)\n    n = int((TOTAL + 2.5) * SR)\n    mus, fx = np.zeros(n), np.zeros(n)\n    bpm = 112\n    beat = 60 / bpm\n    chords = [(110.0, 164.81, 220.0, 261.63, 329.63, 493.88), (87.31, 130.81, 174.61, 220.0, 261.63, 329.63), (65.41, 130.81, 196.0, 246.94, 329.63, 392.0), (98.0, 146.83, 196.0, 246.94, 293.66, 392.0)]\n    clen = beat * 16\n    t, k = 0.0, 0\n    while t < TOTAL:\n        ch = chords[k % 4]\n        dur = clen + 1.5\n        m = int(dur * SR)\n        tt = np.arange(m) / SR\n        pad = np.zeros(m)\n        for f in ch:\n            for det in (-0.35, 0.0, 0.35):\n                pad += np.sin(2 * np.pi * (f + det) * tt + rng.uniform(0, 6.28)) * (0.9 if f < 150 else 0.55)\n        e = np.minimum(tt / 1.6, 1) * np.minimum((dur - tt) / 1.5, 1)\n        add(mus, pad * e * (0.75 + 0.25 * np.sin(2 * np.pi * 0.13 * tt + k)) * 0.020, t)\n        t += clen\n        k += 1\n    start, step_in, kit, stats, end = START[\"s2\"], START[\"s3\"], START[\"s7\"], START[\"s12\"], START[\"s13\"]\n    bt, nb = start, 0\n    while bt < end + 0.3:\n        kn = int(0.30 * SR)\n        tk = np.arange(kn) / SR\n        kick = np.sin(2 * np.pi * np.cumsum(48 + 70 * np.exp(-tk * 24)) / SR) * np.exp(-tk * 9)\n        add(mus, kick * (0.5 + 0.3 * (bt > step_in) + 0.1 * (bt > kit)) * 0.34, bt)\n        if nb % 2 == 1 and bt > step_in - 1:\n            hn = int(0.05 * SR)\n            hat = np.diff(np.concatenate([[0], rng.standard_normal(hn) * np.exp(-np.arange(hn) / SR * 80)]))\n            add(mus, hat * 0.05, bt + beat / 2)\n        if nb % 4 == 0:\n            root = chords[int((bt - start) // clen) % 4][0] * 0.5\n            bn = int(beat * 3.5 * SR)\n            tb = np.arange(bn) / SR\n            add(mus, (np.sin(2 * np.pi * root * tb) * np.exp(-tb * 1.4) + 0.3 * np.sin(2 * np.pi * root * 2 * tb) * np.exp(-tb * 3)) * 0.2, bt)\n        bt += beat\n        nb += 1\n    pent = [440.0, 523.25, 587.33, 659.25, 783.99, 880.0]\n    at, ai = step_in, 0\n    while at < end - 0.3:\n        pn = int(0.45 * SR)\n        tp = np.arange(pn) / SR\n        f0 = pent[[0, 2, 4, 3, 5, 3, 2, 1][ai % 8]] * (2 if at > kit else 1)\n        add(mus, (np.sin(2 * np.pi * f0 * tp) + 0.3 * np.sin(2 * np.pi * f0 * 2 * tp)) * np.exp(-tp * 7) * (0.04 + 0.02 * (at > kit)), at)\n        at += beat / 2\n        ai += 1\n    for tw in sorted(set(round(x, 2) for x in ev[\"whoosh\"])):\n        wn = int(0.55 * SR)\n        add(fx, bandnoise(wn, 500, 6000, rng) * np.sin(np.pi * np.linspace(0, 1, wn)) ** 2 * 0.15, tw)\n    for tc in sorted(set(round(x, 2) for x in ev[\"click\"])):\n        cn = int(0.07 * SR)\n        tcn = np.arange(cn) / SR\n        add(fx, np.sin(2 * np.pi * 1850 * tcn) * np.exp(-tcn * 70) * 0.10 + rng.standard_normal(cn) * np.exp(-tcn * 150) * 0.03, tc)\n    for (tt0, dur, nch) in ev[\"type\"]:  # soft keystrokes while text is typed\n        for q in range(nch):\n            tq = tt0 + dur * q / max(nch, 1)\n            cn = int(0.03 * SR)\n            tcn = np.arange(cn) / SR\n            add(fx, rng.standard_normal(cn) * np.exp(-tcn * 220) * 0.035 + np.sin(2 * np.pi * 2600 * tcn) * np.exp(-tcn * 200) * 0.02, tq)\n    for tb in ev[\"bell\"]:\n        bn = int(2.2 * SR)\n        tbn = np.arange(bn) / SR\n        add(fx, np.sin(2 * np.pi * 440 * tbn + np.sin(2 * np.pi * 616 * tbn) * 2.2 * np.exp(-tbn * 2)) * np.exp(-tbn * 1.7) * 0.18, tb)\n        sn = int(0.8 * SR)\n        ts = np.arange(sn) / SR\n        add(fx, np.sin(2 * np.pi * (46 + 40 * np.exp(-ts * 14)) * ts) * np.exp(-ts * 4.5) * 0.38, tb)\n    for tp in ev[\"pay\"]:\n        pn = int(1.4 * SR)\n        tpn = np.arange(pn) / SR\n        add(fx, sum(np.sin(2 * np.pi * f * tpn) for f in (392.0, 493.88, 587.33, 783.99)) * np.exp(-tpn * 2.4) * 0.065, tp)\n        add(fx, np.sin(2 * np.pi * (40 + 50 * np.exp(-tpn * 12)) * tpn) * np.exp(-tpn * 5) * 0.32, tp)\n    for tb, m in ev[\"blip\"]:\n        bn = int(0.5 * SR)\n        tbn = np.arange(bn) / SR\n        add(fx, np.sin(2 * np.pi * [392.0, 440.0, 523.25, 659.25][m] * tbn) * np.exp(-tbn * 6) * 0.10, tb)\n    rn = int(1.2 * SR)\n    add(fx, bandnoise(rn, 300, 7000, rng) * np.linspace(0, 1, rn) ** 2.2 * 0.11, stats - 1.25)\n    for tr in ev[\"resolve\"]:\n        rn = int(4.2 * SR)\n        trn = np.arange(rn) / SR\n        add(fx, sum(np.sin(2 * np.pi * f * trn) for f in (110.0, 220.0, 329.63, 440.0, 659.25)) * np.minimum(trn / 0.6, 1) * np.exp(-trn * 0.55) * 0.06, tr)\n    mix = mus + fx\n    tail = np.ones(n)\n    fs = int((TOTAL - 0.2) * SR)\n    tail[fs:] = np.linspace(1, 0, n - fs)\n    mix = np.tanh(mix * tail * 1.6) / 1.6\n    L, R = mix.copy(), mix.copy()\n    d = int(0.011 * SR)\n    R[d:] = 0.85 * mix[:-d] + 0.15 * mix[d:]\n    L /= np.max(np.abs(L)) / 0.85\n    R /= np.max(np.abs(R)) / 0.85\n    pcm = (np.clip(np.stack([L, R], 1), -1, 1) * 32767).astype(\"<i2\")\n    out = ROOT / \"audio\"\n    out.mkdir(exist_ok=True)\n    with wave.open(str(out / \"mochi-film.wav\"), \"wb\") as w:\n        w.setnchannels(2)\n        w.setsampwidth(2)\n        w.setframerate(SR)\n        w.writeframes(pcm.tobytes())\n\n\nif __name__ == \"__main__\":\n    ev = build()\n    make_audio(ev)\n    (ROOT / \"beat-sheet.json\").write_text(json.dumps({\"width\": W, \"height\": H, \"fps\": FPS, \"duration\": round(TOTAL, 2), \"scenes\": [{\"id\": s[0], \"kind\": s[1], \"start\": s[2], \"dur\": s[3]} for s in SC],\n                                                       \"source\": \"stills and assets recorded from the real app (capture.mjs); copy from cap/job.json\"}, indent=1))\n    print(\"built\", round(TOTAL, 1), \"s\")\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"55e8a356-30db-45a1-8552-d4a9a7cdc738","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"d1a90136-ab51-4450-87af-371f07f2f333","userType":"external","entrypoint":"cli","cwd":"/Users/advikdivekar/Desktop/sellcraft/video/mochi-film","sessionId":"159a4645-4bae-4261-ac0b-464a7f4accd7","version":"2.1.300","gitBranch":"HEAD"}
