:.3f});')\n        if n > 0:\n            js.append(f'  tl.set(\"#s6f{n - 1}\", {{ opacity: 0 }}, {ts:.3f});')\n    for k in range(total_b + 1):\n        ta = t0 + 0.35 + (k / total_b) * SPAN\n        tb = t0 + 0.35 + ((k + 1) / total_b) * SPAN\n        hide = f'tl.set(e, {{ visibility: \"hidden\" }}, {tb:.3f});' if k < total_b else \"\"\n        js.append(f\"  {{ const e = mk('s6n', '{k}<small style=\\\\\"font-size:.28em;color:#037A84;margin-left:10px;letter-spacing:0\\\\\">s</small>'); tl.set(e, {{ visibility: 'visible' }}, {ta:.3f}); {hide} }}\")\n    ev[\"pay\"].append(t0 + 0.35 + SPAN)\n\n'''\ns=s[:a]+gen+s[b:]\n# --- results scenes: no step dots, relabel\ns=s.replace('+ \"\".join(th) + dots(\"s7\", 3) + \"</div>\")','+ \"\".join(th) + \"</div>\")')\ns=s.replace('05 · Your kit</div>','Results · The kit</div>')\ns=s.replace('On your phone</div>','Results · The video ad</div>')\ns=s.replace('06 · Copy</div>','Results · The copy</div>')\ns=s.replace(\"\"\"                + dots(\"s9\", 3) + \"</div>\")\"\"\",\"\"\"                + \"</div>\")\"\"\")\ns=s.replace('07 · Trust</div>','Results · Trust</div>')\ns=s.replace('+ dots(\"s10\", 4) + \"</div>\")','+ \"</div>\")')\ns=s.replace('08 · Why it matters','Why it matters').replace('09 · Results','By the numbers')\n# --- share scene (after trust)\na=s.index(\"    # ---------- S11: benefits\")\nshare='''    # ---------- S14: share / export ----------\n    t0 = START[\"s14\"]\n    sch = \"\".join(f'<div id=\"s14c{n}\" class=\"chip\"><i></i>{c}</div>' for n, c in enumerate([\"Copy a post or share from your phone\", \"Download the whole kit as a zip\", \"Shopify draft, if a store is connected\"]))\n    html.append(scene_open(\"s14\", \"share\", \"light\") + bug(\"s14\") +\n                f'<div class=\"col\" style=\"left:110px; top:180px; width:540px; height:700px; gap:30px; justify-content:center\">'\n                f'<div id=\"s14k\" class=\"mono\" style=\"font-size:26px; color:var(--turq-d)\">Results · Share</div>'\n                f'<div id=\"s14t\" class=\"big\" style=\"font-size:82px\">{words(\"Share or export.\")}</div>'\n                f'<div style=\"display:flex; flex-direction:column; gap:14px; align-items:flex-start; margin-top:10px\">{sch}</div></div>'\n                + window(\"s14\", [(\"d-14-share\", 0.0, 3.2, (0, 150, 1760), (40, 210, 1560))]) + \"</div>\")\n    js.append(\"  // s14\")\n    js.append(f'  tl.from(\"#s14k\", {{ opacity: 0, x: -20, duration: 0.35 }}, {t0 + 0.05:.2f});')\n    reveal(\"s14t\", t0 + 0.12, 0.07)\n    for n in range(3):\n        tt = t0 + 0.55 + n * 0.3\n        js.append(f'  tl.from(\"#s14c{n}\", {{ opacity: 0, y: 22, duration: 0.35 }}, {tt:.2f});')\n        ev[\"click\"].append(tt)\n\n'''\ns=s[:a]+share+s[a:]\ns=s.replace('ev[\"bell\"].extend([START[\"s2\"] + 0.1, t0 + 0.1])','ev[\"bell\"].extend([0.15, t0 + 0.1])')\n# gaps in 'blip' times reference stats\nopen('build.py','w').write(s)\nE\ngrep -n \"START\\[\\\"s12\\\"\\]\\|stats, end\\|kit, stats\" build.py | head; for f in cap/b/b-*.png; do n=$(basename $f .png); ffmpeg -y -loglevel error -i $f -q:v 3 project/assets/s/$n.jpg; done; ls project/assets/s | wc -l","timeout":200000},"caller":{"type":"direct"}}]}}
