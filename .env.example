# --- LLM (open-weight via Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# "Best quality" copy (larger, about a minute). Slower but fewer flagged claims.
OLLAMA_MODEL=gemma3:12b
# "Fast" copy, the default in the app: a small model, about 20 seconds end to end
OLLAMA_FAST_MODEL=gemma3:4b
# Set true to use the labelled deterministic Demo Mode when Ollama is not running
DEMO_MODE=false

# --- Video ---
VIDEO_PROVIDER=fallback
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=

# --- Voiceover (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# --- Observability (optional) ---
SENTRY_DSN=

# --- Storage ---
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
DATABASE_URL=sqlite:///data/sellcraft.db

# --- Speed / quality ---
# Photo reading is simple, so a smaller model is fine and much faster. Copy uses OLLAMA_MODEL.
VISION_MODEL=gemma3:4b
# Background removal model for the studio video/photos (downloads once): silueta (44 MB) or u2net (176 MB)
CUTOUT_MODEL=silueta

# --- Shopify (optional, free dev store): creates a DRAFT product with your studio photos + video ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
