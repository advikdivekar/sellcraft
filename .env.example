# --- LLM (open-weight via Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Set true to use the labelled deterministic Demo Mode when Ollama is not running
DEMO_MODE=false

# --- Video ---
VIDEO_PROVIDER=fallback
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=

# --- Voiceover (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# --- Observability (optional) ---
SENTRY_DSN=

# --- Storage ---
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
DATABASE_URL=sqlite:///data/sellcraft.db
